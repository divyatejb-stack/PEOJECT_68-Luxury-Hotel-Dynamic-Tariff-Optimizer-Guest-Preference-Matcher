//4. Generic inventory and synchronized reservation operation
public class HotelReservationService {
    private final Map<Integer, Room> inventory = new HashMap<>();
    private final List<Booking> bookings = new ArrayList<>();

    public synchronized Booking reserveRoom(
            int roomNumber, Guest guest)
            throws RoomUnavailableException {
        Room room = inventory.get(roomNumber);
        if (room == null || room.isOccupied()) {
            throw new RoomUnavailableException(
                "Selected room is unavailable");
        }

        // Availability check and update occur under one lock.
        room.setOccupied(true);
        Booking booking = new Booking(guest, room);
        bookings.add(booking);
        return booking;
    }
}
//The synchronized method protects the check-and-reserve sequence. In a complete implementation, the service should also validate guest preferences, calculate the current occupancy tariff and handle rollback if booking creation fails.
