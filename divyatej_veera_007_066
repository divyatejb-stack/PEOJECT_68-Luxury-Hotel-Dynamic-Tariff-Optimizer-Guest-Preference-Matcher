//1. Encapsulated Room model
public class Room {
    private final int roomNumber;
    private String category;
    private double basePrice;
    private final Set<String> amenities;
    private boolean occupied;

    public Room(int roomNumber, String category,
                double basePrice, Set<String> amenities) {
        if (roomNumber <= 0 || basePrice <= 0)
            throw new IllegalArgumentException("Invalid room details");
        this.roomNumber = roomNumber;
        this.category = category;
        this.basePrice = basePrice;
        this.amenities = new HashSet<>(amenities);
        this.occupied = false;
    }

    public int getRoomNumber() { return roomNumber; }
    public String getCategory() { return category; }
    public double getBasePrice() { return basePrice; }
    public Set<String> getAmenities() {
        return Collections.unmodifiableSet(amenities);
    }
    public boolean isOccupied() { return occupied; }
    public void setOccupied(boolean occupied) {
        this.occupied = occupied;
    }
}
//The fields are private, and the amenities getter returns an unmodifiable view so callers cannot directly modify the internal set.
//2. Occupancy-based dynamic tariff
public class DynamicTariffCalculator {
    public double calculateTariff(double basePrice, double occupancyPercent) {
        if (occupancyPercent > 85.0) return basePrice * 1.40;
        if (occupancyPercent > 70.0) return basePrice * 1.20;
        return basePrice;
    }
}
//The higher threshold is checked first. Therefore, occupancy above 85% receives a 40% increase rather than both increases being added.
